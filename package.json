{
  "name": "night-of-witnesses",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=tap \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/src/server/main.js",
    "add-bots": "node scripts/add-bots.mjs",
    "test:e2e": "playwright test",
    "test:manual": "node scripts/open-3p.js"
  },
  "dependencies": {
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
