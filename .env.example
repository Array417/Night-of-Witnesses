# Night of Witnesses Docker 環境設定
# 複製此檔為 .env 再按需要修改：
#   cp .env.example .env

# 瀏覽器實際使用嘅來源網址（逗號分隔多個）。
# 經 Caddy HTTPS（推薦）：
#   ORIGIN=https://now.yourdomain.com
# 直接 HTTP / 公網 IP：
#   ORIGIN=http://1.2.3.4:8213
#   ORIGIN=http://now.yourdomain.com:8213
# 如果只用本地 / 同區網測試：
#   ORIGIN=http://localhost:8213,http://127.0.0.1:8213,http://192.168.1.50:8213
ORIGIN=http://localhost:8213,http://127.0.0.1:8213

# 語音用 ICE 伺服器（JSON 陣列，最多 8 筆）。
# 跨網路語音需要 STUN/TURN，否則只保證同區網可用。範例（佔位符）：
# RTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.example.org:3478"]}]
RTC_ICE_SERVERS_JSON=[]

# Self-hosted coturn (optional): set all three, then enable the voice profile.
# Domain/IPv4 only, without scheme or port. Can use the existing game domain.
TURN_HOST=
# Public IPv4 of the server/router; update when your ISP changes it.
TURN_EXTERNAL_IP=
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This secret is shared between the game server and coturn, never sent to browsers.
TURN_SHARED_SECRET=
